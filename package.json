{
  "name": "expense-bot",
  "version": "1.0.0",
  "description": "LINE expense tracking chatbot for a couple",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "db:schema": "cat supabase/schema.sql",
    "db:check": "node -e \"const { getDbStatus } = require('./src/services/db'); console.log(JSON.stringify(getDbStatus(), null, 2));\"",
    "eval:nl": "node scripts/eval-nl.js",
    "export:nl-log": "node scripts/export-nl-log.js",
    "richmenu:setup": "node scripts/richmenu.js setup",
    "richmenu:list": "node scripts/richmenu.js list",
    "richmenu:delete": "node scripts/richmenu.js delete"
  },
  "keywords": [
    "line",
    "expense",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@line/bot-sdk": "^11.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
